# ==============================================================================
# DISCORD VERIFICATION BOT CONFIGURATION
# ==============================================================================

# Discord Bot Token (จาก Discord Developer Portal > Bot > Reset Token)
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord OAuth2 App Credentials (จาก Discord Developer Portal > OAuth2 > General)
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# URL Callback ที่ตั้งไว้ใน OAuth2 Redirects (เช่น https://your-service.onrender.com/callback)
REDIRECT_URI=https://your-service.onrender.com/callback

# ID ของ Discord Server เริ่มต้น (Guild ID) - สามารถกำหนดในคำสั่ง /setup_verify แยกแต่ละ Server ได้
GUILD_ID=123456789012345678

# ID ของ Role เริ่มต้นที่ต้องการมอบให้เมื่อ Verify ผ่าน - สามารถเลือกตอนใช้ /setup_verify ได้
VERIFIED_ROLE_ID=123456789012345678

# Web Server Port (บน Render จะถูกตั้งค่าอัตโนมัติ)
PORT=5000
