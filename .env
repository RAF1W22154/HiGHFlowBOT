# Discord Bot Token (จาก Discord Developer Portal > Bot > Token)
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Discord OAuth2 App Credentials (จาก Discord Developer Portal > OAuth2 > General)
CLIENT_ID=YOUR_CLIENT_ID_HERE
CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# URL Callback ที่ตั้งไว้ใน OAuth2 Redirects (เช่น https://your-render-app.onrender.com/callback)
REDIRECT_URI=https://your-app-name.onrender.com/callback

# ID ของ Discord Server (Guild ID)
GUILD_ID=123456789012345678

# ID ของ Role ที่ต้องการมอบให้เมื่อ Verify ผ่าน
VERIFIED_ROLE_ID=123456789012345678

# Web Server Port (Render จะ override อัตโนมัติ)
PORT=5000
